{
    "manifest_version": 3,
    "name": "Zoom Toggler",
    "version": "0.0.9",
    "description": "Quickly toggle page zoom between up to 3 levels, with base zoom levels per site and per computer",
    "permissions": [
        "storage"
    ],
    "optional_host_permissions": [
        "*://*/*"
    ],
    "options_page": "options.html",
    "background": {
        "service_worker": "background.js"
    },
    "action": {
      "default_icon": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
      }
    },
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    }
}
